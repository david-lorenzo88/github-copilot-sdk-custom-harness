<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- GHCP001: the Copilot SDK marks permission decisions, BYOK token providers and other APIs as experimental. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.25" />
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.27.0" />
  </ItemGroup>

</Project>
